# Ambiente Python local (cada um recria com: python -m venv .venv)
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Dados brutos e processados: são grandes e os scripts baixam/geram de novo.
# Mantemos só os arquivos .gitkeep para as pastas existirem no GitHub.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Configurações locais do Claude Code
.claude/settings.local.json

# Arquivos do sistema
Thumbs.db
desktop.ini
.DS_Store
